<!DOCTYPE html>
<html>
<head>
  <title>Produk</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>

<div class="container mt-4">
  <h2>Data Produk</h2>

  <a href="/add" class="btn btn-primary mb-3">Tambah</a>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nama</th>
        <th>Harga</th>
        <th>Stok</th>
        <th>Gambar</th>
        <th>Aksi</th>
      </tr>
    </thead>

    <tbody>
      <% if (data && data.length > 0) { %>

        <% for (let i = 0; i < data.length; i++) { %>
          <tr>
            <td><%= data[i].id %></td>
            <td><%= data[i].nama_produk %></td>
            <td>Rp <%= data[i].harga %></td>
            <td><%= data[i].stok %></td>

            <td>
              <% if (data[i].gambar) { %>
                <img src="/uploads/<%= data[i].gambar %>" width="80">
              <% } else { %>
                Tidak ada
              <% } %>
            </td>

            <td>
              <a href="/edit/<%= data[i].id %>" class="btn btn-warning btn-sm">Edit</a>
              <a href="/delete/<%= data[i].id %>" class="btn btn-danger btn-sm"
                 onclick="return confirm('Yakin hapus?')">Hapus</a>
            </td>
          </tr>
        <% } %>

      <% } else { %>
        <tr>
          <td colspan="6">Data kosong</td>
        </tr>
      <% } %>
    </tbody>

  </table>
</div>

</body>
</html>