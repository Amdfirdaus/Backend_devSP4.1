<!DOCTYPE html>
<html>
<head>
  <title>CRUD Mahasiswa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background-color:#f5f7fa;">

<div class="container mt-5">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Data Mahasiswa</h2>
    <a href="/mahasiswa/add" class="btn btn-primary shadow-sm">+ Tambah</a>
  </div>

  <!-- Card -->
  <div class="card shadow-sm border-0">
    <div class="card-body">

      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>No</th>
            <th>Nama</th>
            <th>NIM</th>
            <th>Jurusan</th>
            <th>Alamat</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>

        <tbody>
          <% if (mahasiswa.length > 0) { %>
            <% mahasiswa.forEach(function(mhs, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-semibold"><%= mhs.nama %></td>
                <td><%= mhs.nim %></td>
                <td><span class="badge bg-info text-dark"><%= mhs.jurusan %></span></td>
                <td><%= mhs.alamat %></td>
                <td class="text-center">

                  <!-- Edit -->
                  <a href="/mahasiswa/edit/<%= mhs._id %>" 
                     class="btn btn-warning btn-sm me-1">
                     Edit
                  </a>

                  <!-- Delete -->
                  <a href="/mahasiswa/delete/<%= mhs._id %>" 
                     class="btn btn-danger btn-sm"
                     onclick="return confirm('Yakin mau hapus data ini?')">
                     Delete
                  </a>

                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted">
                Belum ada data mahasiswa
              </td>
            </tr>
          <% } %>
        </tbody>

      </table>

    </div>
  </div>

</div>

</body>
</html>